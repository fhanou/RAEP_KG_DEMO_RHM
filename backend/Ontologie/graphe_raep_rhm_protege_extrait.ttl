<http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm> rdf:type owl:Ontology ;
                                                               dcterms:description "Ontological foundation derived from the conceptual model of a drinking water supply network (RAEP). This model serves as a reference benchmark for the knowledge graph integrated into the application."@en ;
                                                               dcterms:title "RAEP-RHM Ontology"@en ;
                                                               rdfs:label "RAEP-RHM Drinking Water Supply Network Ontology"@en ;
                                                               owl:versionInfo "1.0.0 - Benchmark & Exploration Platform" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#note
skos:note rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/supplies
raep:supplies rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf raep:HydraulicRelations ;
              owl:inverseOf raep:isSuppliedBy ;
              rdfs:domain raep:HydraulicInfrastructure ;
              rdfs:range raep:HydraulicInfrastructure ;
              rdfs:label "supplies"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/belongsToMunicipality
raep:belongsToMunicipality rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf raep:AdministrativeLocation ;
                        rdfs:domain raep:Neighborhood ;
                        rdfs:range raep:Municipality ;
                        rdfs:label "belongs to municipality"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/connectedTo
raep:connectedTo rdf:type owl:ObjectProperty ,
                        owl:SymmetricProperty ;
               rdfs:subPropertyOf raep:HydraulicRelations ;
               rdfs:domain raep:HydraulicInfrastructure ;
               rdfs:range raep:HydraulicInfrastructure ;
               rdfs:label "connected to"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/contains
raep:contains rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf raep:AdministrativeLocation ;
              owl:inverseOf raep:isLocatedIn ;
              rdfs:domain raep:AdministrativeEntity ;
              rdfs:range owl:Thing ;
              rdfs:label "contains"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/records
raep:records rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf raep:ObservationMonitoring ;
                owl:inverseOf raep:isRecordedBy ;
                rdfs:domain raep:HydraulicInfrastructure ;
                rdfs:range raep:Observation ;
                rdfs:label "records"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/isSuppliedBy
raep:isSuppliedBy rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf raep:HydraulicRelations ;
                    rdfs:domain raep:HydraulicInfrastructure ;
                    rdfs:range raep:HydraulicInfrastructure ;
                    rdfs:label "is supplied by"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/isRecordedBy
raep:isRecordedBy rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf raep:ObservationMonitoring ;
                      rdfs:domain raep:Observation ;
                      rdfs:range raep:HydraulicInfrastructure ;
                      rdfs:label "is recorded by"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/isLocatedIn
raep:isLocatedIn rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf raep:AdministrativeLocation ;
                 rdfs:domain owl:Thing ;
                 rdfs:range raep:AdministrativeEntity ;
                 rdfs:label "is located in"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/HydraulicRelations
raep:HydraulicRelations rdf:type owl:ObjectProperty ;
                           rdfs:label "Hydraulic Relations"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/AdministrativeLocation
raep:AdministrativeLocation rdf:type owl:ObjectProperty ;
                                rdfs:label "Administrative Location"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/ObservationMonitoring
raep:ObservationMonitoring rdf:type owl:ObjectProperty ;
                      rdfs:label "Observation Monitoring"@en .


