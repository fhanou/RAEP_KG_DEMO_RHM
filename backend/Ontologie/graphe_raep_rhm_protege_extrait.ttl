###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/HydraulicInfrastructure
raep:HydraulicInfrastructure rdf:type owl:Class ;
                               rdfs:label "Hydraulic Infrastructure"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/AdministrativeEntity
raep:AdministrativeEntity rdf:type owl:Class ;
                          rdfs:label "Administrative Entity"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/Observation
raep:Observation rdf:type owl:Class ;
                 rdfs:label "Observation"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/WaterIntake
raep:WaterIntake rdf:type owl:Class ;
             rdfs:subClassOf raep:HydraulicInfrastructure ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty raep:records ;
                               owl:someValuesFrom raep:RawWater
                             ] ;
             rdfs:label "Water Intake"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/Municipality
raep:Municipality rdf:type owl:Class ;
             rdfs:subClassOf raep:AdministrativeEntity ;
             rdfs:label "Municipality"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/AdductionConduit
raep:AdductionConduit rdf:type owl:Class ;
                       rdfs:subClassOf raep:HydraulicInfrastructure ;
                       rdfs:label "Adduction Conduit"@en ;
                       skos:note "Class retained in schema even if adduction conduit spatial data is not yet populated."@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/IntakeConduit
raep:IntakeConduit rdf:type owl:Class ;
                    rdfs:subClassOf raep:HydraulicInfrastructure ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty raep:connectedTo ;
                                      owl:someValuesFrom raep:WaterIntake
                                    ] ;
                    rdfs:label "Intake Conduit"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/DistributionConduit
raep:DistributionConduit rdf:type owl:Class ;
                          rdfs:subClassOf raep:HydraulicInfrastructure ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty raep:connectedTo ;
                                            owl:someValuesFrom raep:DistributionPoint
                                          ] ;
                          rdfs:label "Distribution Conduit"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/RawWater
raep:RawWater rdf:type owl:Class ;
              rdfs:subClassOf raep:Observation ;
              rdfs:label "Raw Water"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/DistributedWater
raep:DistributedWater rdf:type owl:Class ;
                   rdfs:subClassOf raep:Observation ;
                   rdfs:label "Distributed Water"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/TreatedWater
raep:TreatedWater rdf:type owl:Class ;
                rdfs:subClassOf raep:Observation ;
                rdfs:label "Treated Water"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/DistributionPoint
raep:DistributionPoint rdf:type owl:Class ;
                       rdfs:subClassOf raep:HydraulicInfrastructure ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty raep:records ;
                                         owl:someValuesFrom raep:DistributedWater
                                       ] ;
                       rdfs:label "Distribution Point"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/Neighborhood
raep:Neighborhood rdf:type owl:Class ;
              rdfs:subClassOf raep:AdministrativeEntity ;
              rdfs:label "Neighborhood"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/WaterReservoir
raep:WaterReservoir rdf:type owl:Class ;
               rdfs:subClassOf raep:HydraulicInfrastructure ;
               rdfs:label "Water Reservoir"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/WaterTreatmentPlant
raep:WaterTreatmentPlant rdf:type owl:Class ;
                       rdfs:subClassOf raep:HydraulicInfrastructure ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty raep:records ;
                                         owl:someValuesFrom raep:TreatedWater
                                       ] ;
                       rdfs:label "Water Treatment Plant"@en .


