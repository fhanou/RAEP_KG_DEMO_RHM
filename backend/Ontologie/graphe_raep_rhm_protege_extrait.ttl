                             raep:AttributesWaterReservoir ,
                             raep:AttributesDistributionPoint ,
                             raep:AttributesIntakeConduit ,
                             raep:AttributesAdductionConduit ,
                             raep:AttributesDistributionConduit ,
                             raep:AttributesNeighborhood ,
                             raep:AttributesMunicipality ;
          rdfs:label "GEOM"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/capacity
raep:capacity rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf raep:AttributesWaterTreatmentPlant ;
              rdfs:domain raep:WaterTreatmentPlant ;
              rdfs:range xsd:decimal ;
              rdfs:label "capacity"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/municipalityCode
raep:municipalityCode rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf raep:AttributesMunicipality ;
                 rdfs:domain raep:Municipality ;
                 rdfs:range xsd:string ;
