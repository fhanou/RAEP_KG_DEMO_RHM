###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/neighborhoodCode
raep:neighborhoodCode rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf raep:AttributesNeighborhood ;
                  rdfs:domain raep:Neighborhood ;
                  rdfs:range xsd:string ;
                  rdfs:label "neighborhood code"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/observationDate
raep:observationDate rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf raep:AttributesWaterIntake ,
                                        raep:AttributesRawWater ,
                                        raep:AttributesTreatedWater ,
                                        raep:AttributesDistributedWater ;
                     rdfs:domain raep:Observation ;
                     rdfs:range xsd:dateTime ;
                     rdfs:label "observation date"@en .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/flowRate
raep:flowRate rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf raep:AttributesWaterIntake ;
           rdfs:domain raep:WaterIntake ;
           rdfs:range xsd:decimal ;
