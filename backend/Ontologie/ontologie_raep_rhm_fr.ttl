###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/population
raep:population rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf raep:AttributsQuartier ,
                                   raep:AttributsCommune ;
                rdfs:domain raep:EntiteAdministrative ;
                rdfs:range xsd:decimal ;
                rdfs:label "population"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/quantite
raep:quantite rdf:type owl:DatatypeProperty ;
