###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/longueur
raep:longueur rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf raep:AttributsConduiteAmenee ,
                                 raep:AttributsConduiteAdduction ,
                                 raep:AttributsConduiteDistribution ;
              rdfs:domain raep:InfrastructureHydraulique ;
              rdfs:range xsd:decimal ;
