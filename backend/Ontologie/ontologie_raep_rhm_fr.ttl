#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#note
skos:note rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/alimente
raep:alimente rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf raep:RelationsHydrauliques ;
              owl:inverseOf raep:estAlimentePar ;
              rdfs:domain raep:InfrastructureHydraulique ;
              rdfs:range raep:InfrastructureHydraulique ;
              rdfs:label "alimente"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/appartientACommune
raep:appartientACommune rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf raep:LocalisationAdministrative ;
                        rdfs:domain raep:Quartier ;
                        rdfs:range raep:Commune ;
                        rdfs:label "appartient a commune"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/connecteA
raep:connecteA rdf:type owl:ObjectProperty ,
                        owl:SymmetricProperty ;
               rdfs:subPropertyOf raep:RelationsHydrauliques ;
               rdfs:domain raep:InfrastructureHydraulique ;
               rdfs:range raep:InfrastructureHydraulique ;
               rdfs:label "connecte a"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/contient
raep:contient rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf raep:LocalisationAdministrative ;
              owl:inverseOf raep:seSitueDans ;
              rdfs:domain raep:EntiteAdministrative ;
              rdfs:range owl:Thing ;
              rdfs:label "contient"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/enregistre
raep:enregistre rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf raep:SuiviObservation ;
                owl:inverseOf raep:estEnregistrePar ;
                rdfs:domain raep:InfrastructureHydraulique ;
                rdfs:range raep:Observation ;
                rdfs:label "enregistre"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/estAlimentePar
raep:estAlimentePar rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf raep:RelationsHydrauliques ;
                    rdfs:domain raep:InfrastructureHydraulique ;
                    rdfs:range raep:InfrastructureHydraulique ;
                    rdfs:label "est alimente par"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/estEnregistrePar
raep:estEnregistrePar rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf raep:SuiviObservation ;
                      rdfs:domain raep:Observation ;
                      rdfs:range raep:InfrastructureHydraulique ;
                      rdfs:label "est enregistre par"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/seSitueDans
raep:seSitueDans rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf raep:LocalisationAdministrative ;
                 rdfs:domain owl:Thing ;
                 rdfs:range raep:EntiteAdministrative ;
                 rdfs:label "se situe dans"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/RelationsHydrauliques
raep:RelationsHydrauliques rdf:type owl:ObjectProperty ;
                           rdfs:label "RelationsHydrauliques"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/LocalisationAdministrative
raep:LocalisationAdministrative rdf:type owl:ObjectProperty ;
                                rdfs:label "LocalisationAdministrative"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/SuiviObservation
raep:SuiviObservation rdf:type owl:ObjectProperty ;
                      rdfs:label "SuiviObservation"@fr .


