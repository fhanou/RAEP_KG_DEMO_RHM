###  http://www.opengis.net/ont/geosparql#asWKT
geo:asWKT rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf raep:AttributsCaptage ,
                             raep:AttributsStationTraitement ,
                             raep:AttributsReservoir ,
                             raep:AttributsPointDistribution ,
                             raep:AttributsConduiteAmenee ,
                             raep:AttributsConduiteAdduction ,
                             raep:AttributsConduiteDistribution ,
                             raep:AttributsQuartier ,
                             raep:AttributsCommune ;
          rdfs:label "GEOM"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/capacite
raep:capacite rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf raep:AttributsStationTraitement ;
              rdfs:domain raep:StationTraitement ;
              rdfs:range xsd:decimal ;
              rdfs:label "capacite"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/codeCommune
raep:codeCommune rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf raep:AttributsCommune ;
                 rdfs:domain raep:Commune ;
                 rdfs:range xsd:string ;
                 rdfs:label "code commune"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/codeQuartier
raep:codeQuartier rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf raep:AttributsQuartier ;
                  rdfs:domain raep:Quartier ;
                  rdfs:range xsd:string ;
                  rdfs:label "code quartier"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/dateObservation
raep:dateObservation rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf raep:AttributsCaptage ,
                                        raep:AttributsEauBrute ,
                                        raep:AttributsEauTraitee ,
                                        raep:AttributsEauDistribuee ;
                     rdfs:domain raep:Observation ;
                     rdfs:range xsd:dateTime ;
                     rdfs:label "date d'observation"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/debit
raep:debit rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf raep:AttributsCaptage ;
           rdfs:domain raep:Captage ;
           rdfs:range xsd:decimal ;
           rdfs:label "debit"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/demande
###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/elevation
raep:elevation rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf raep:AttributsStationTraitement ;
               rdfs:domain raep:StationTraitement ;
               rdfs:range xsd:decimal ;
               rdfs:label "elevation"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/identifiant
raep:identifiant rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf raep:AttributsCaptage ,
                                    raep:AttributsStationTraitement ,
                                    raep:AttributsReservoir ,
                                    raep:AttributsPointDistribution ,
                                    raep:AttributsConduiteAmenee ,
                                    raep:AttributsConduiteAdduction ,
                                    raep:AttributsConduiteDistribution ,
                                    raep:AttributsQuartier ,
                                    raep:AttributsCommune ,
