#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/InfrastructureHydraulique
raep:InfrastructureHydraulique rdf:type owl:Class ;
                               rdfs:label "InfrastructureHydraulique"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/EntiteAdministrative
raep:EntiteAdministrative rdf:type owl:Class ;
                          rdfs:label "EntiteAdministrative"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/Observation
raep:Observation rdf:type owl:Class ;
                 rdfs:label "Observation"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/Captage
raep:Captage rdf:type owl:Class ;
             rdfs:subClassOf raep:InfrastructureHydraulique ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty raep:enregistre ;
                               owl:someValuesFrom raep:EauBrute
                             ] ;
             rdfs:label "Captage"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/Commune
raep:Commune rdf:type owl:Class ;
             rdfs:subClassOf raep:EntiteAdministrative ;
             rdfs:label "Commune"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/ConduiteAdduction
raep:ConduiteAdduction rdf:type owl:Class ;
                       rdfs:subClassOf raep:InfrastructureHydraulique ;
                       rdfs:label "Conduite d'adduction"@fr ;
                       skos:note "Classe conservee meme si les donnees de conduite d'adduction ne sont pas encore disponibles."@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/ConduiteAmenee
raep:ConduiteAmenee rdf:type owl:Class ;
                    rdfs:subClassOf raep:InfrastructureHydraulique ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty raep:connecteA ;
                                      owl:someValuesFrom raep:Captage
                                    ] ;
                    rdfs:label "Conduite amenee"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/ConduiteDistribution
raep:ConduiteDistribution rdf:type owl:Class ;
                          rdfs:subClassOf raep:InfrastructureHydraulique ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty raep:connecteA ;
                                            owl:someValuesFrom raep:PointDistribution
                                          ] ;
                          rdfs:label "Conduite de distribution"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/EauBrute
raep:EauBrute rdf:type owl:Class ;
              rdfs:subClassOf raep:Observation ;
              rdfs:label "Eau brute"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/EauDistribuee
raep:EauDistribuee rdf:type owl:Class ;
                   rdfs:subClassOf raep:Observation ;
                   rdfs:label "Eau distribuee"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/EauTraitee
raep:EauTraitee rdf:type owl:Class ;
                rdfs:subClassOf raep:Observation ;
                rdfs:label "Eau traitee"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/PointDistribution
raep:PointDistribution rdf:type owl:Class ;
                       rdfs:subClassOf raep:InfrastructureHydraulique ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty raep:enregistre ;
                                         owl:someValuesFrom raep:EauDistribuee
                                       ] ;
                       rdfs:label "Point de distribution"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/Quartier
raep:Quartier rdf:type owl:Class ;
              rdfs:subClassOf raep:EntiteAdministrative ;
              rdfs:label "Quartier"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/Reservoir
raep:Reservoir rdf:type owl:Class ;
               rdfs:subClassOf raep:InfrastructureHydraulique ;
               rdfs:label "Reservoir"@fr .


###  http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm/StationTraitement
raep:StationTraitement rdf:type owl:Class ;
                       rdfs:subClassOf raep:InfrastructureHydraulique ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty raep:enregistre ;
                                         owl:someValuesFrom raep:EauTraitee
                                       ] ;
                       rdfs:label "Station de traitement"@fr .


