<http://www.semanticweb.org/hayit/ontologies/2026/5/raep-rhm> rdf:type owl:Ontology ;
                                                               dcterms:description "Socle ontologique issu du MCD d'un reseau d'adduction d'eau potable. Ce modele sert de preuve de faisabilite pour la construction d'un graphe de connaissance integrable a l'application."@fr ;
                                                               dcterms:title "Ontologie RAEP-RHM"@fr ;
                                                               rdfs:label "Ontologie du reseau d'adduction d'eau potable RHM"@fr ;
                                                               owl:versionInfo "0.1.0 - preuve de faisabilite" .

